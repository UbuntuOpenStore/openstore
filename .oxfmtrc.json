{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 140,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "sortImports": true,
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "packages/openstore-api/src/tests/fixtures/**",
    "packages/openstore-web/**",
    "packages/openstore-dpkg/**"
  ]
}
