# This is text to go on a button that will say "Download from the\nOpenStore" (where \n is a line break)
msgid "Download from the"
msgstr "הורדה מ־"

# Discovery section category name
msgid "New and Updated Apps"
msgstr "יישומונים חדשים ועדכניים"

# Discovery section category tagline for "New and Updated Apps"
msgid "Exciting new apps & updates"
msgstr "יישומונים ועדכונים חדשים ומרתקים"

# Discovery section category name
msgid "Health & Wellness"
msgstr "בריאות גוף ונפש"

# Discovery section category tagline for "Health & Wellness"
msgid "An apple a day..."
msgstr "תפוח ביום…"

# Discovery section category name
msgid "Cross Platform Apps"
msgstr "יישומונים רבי פלטפורמות"

# Discovery section category tagline for "Cross Platform Apps"
msgid "Find these apps anywhere"
msgstr "אפשר למצוא את היישומונים האלה בכל מקום"

# Discovery section category name
msgid "Essential Apps"
msgstr "יישומונים חיוניים"

# Discovery section category tagline for "Essential Apps"
msgid "Check these out first"
msgstr "כדאי לבדוק את אלו קודם"

# Discovery section category name
msgid "Dev Tools & Reference"
msgstr "כלי פיתוח וסימוכין"

# Discovery section category tagline for "Dev Tools & Reference"
msgid "Talk is cheap. Show me the code."
msgstr "דיבורים זה בחינם. אני רוצה לראות קוד."

# Discovery section category name
msgid "Most Loved"
msgstr "הכי אהובים"

# Discovery section category tagline for "Most Loved"
msgid "Apps with the highest ratings"
msgstr "יישומונים עם הדירוג הגבוה ביותר"

# Discovery section category tagline for "Utilities"
msgid "It is essential to have good tools"
msgstr "כלים טובים הם מאוד חיוניים"

# Discovery section category name
msgid "Tools"
msgstr "כלים"

# Discovery section category tagline for "Tools"
msgid "Even the simplest tools can empower people to do great things"
msgstr "אפילו הכלים הפשוטים ביותר יכולים להעצים אנשים כדי לעשות דברים אדירים"

# Discovery section category name
msgid "Toolbox"
msgstr "ארגז כלים"

# Discovery section category tagline for "Toolbox"
msgid "It's not the thing itself, but how you use it."
msgstr "זה לא הכלי עצמו, אלא איך משתמשים בו."

# Discovery section category tagline for "Games"
msgid "We are all our own worst enemy. But also, our best teacher."
msgstr "כולנו האויבים הכי גרועים של עצמנו. אבל גם, המורים הכי טובים של עצמנו."

msgid "Fun Games"
msgstr "משחקי הנאה"

# Discovery section category tagline for "Fun Games"
msgid "Cause I always play to win!"
msgstr "כי הכי כיף לשחק בשביל לנצח!"

msgid "Best Games"
msgstr "המשחקים הטובים ביותר"

# Discovery section category tagline for "Best Games"
msgid "Didn't we have some fun though?"
msgstr "אבל איזה כיף היה?"

# Discovery section category name
msgid "Awesome Games"
msgstr "משחקים אדירים"

# Discovery section category tagline for "Awesome Games"
msgid "It's dangerous to go alone, take this!"
msgstr "מסוכן להסתובב סתם ככה, צריך גם כזה!"

# Discovery section category name
msgid "Game Helpers"
msgstr "מסייעי משחקים"

# Discovery section category tagline for "Game Helpers"
msgid "No matter what the game, everyone can agree, games are fun."
msgstr "לא משנה מה המשחק, נוכל כולנו להסכים שמשחקים זה כיף."

# Discovery section category name
msgid "News"
msgstr "חדשות"

# Discovery section category tagline for "News"
msgid "News is only the first rough draft of history"
msgstr "חדשות הן הטיוטה הגסה ביותר של ההיסטוריה"

msgid "Godot Games"
msgstr "משחקי גודו"

# Discovery section category tagline for "Godot Games"
msgid "The game engine you waited for"
msgstr "מנוע המשחקים שכולנו ציפינו לו"

# Discovery section category name
msgid "Fediverse"
msgstr "פדיברס (היקום המקושר)"

# Discovery section category tagline for "Fediverse"
msgid "To infinity and beyond!"
msgstr "אל האינסוף ומעבר לו!"

# Discovery section category name
msgid "Chat Connection"
msgstr "חיבור לצ׳אטים"

# Discovery section category tagline for "Chat Connection"
msgid "Don't forget to text mom!"
msgstr "חשוב לשלוח הודעה לאימא!"

# Discovery section category name
msgid "RSS Feed Readers"
msgstr "מציגי ערוצי RSS"

# Discovery section category tagline for "RSS Feed Readers"
msgid "RSS is dead, long live RSS!"
msgstr "RSS ז״ל, יחי RSS!"

# Discovery section category name
msgid "Core Apps"
msgstr "יישומוני ליבה"

# Discovery section category tagline for "Core Apps"
msgid "There is an app for that"
msgstr "בטוח יש איזה יישומון שעושה את זה"
