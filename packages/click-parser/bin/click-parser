#!/usr/bin/env node
// SPDX-License-Identifier: AGPL-3.0-or-later

const { parseArgs } = require('node:util');

const parse = require('../dist/src/index').default;

const { values, positionals } = parseArgs({
  args: process.argv.slice(2),
  options: {
    icon: { type: 'boolean', short: 'i', default: false },
    version: { type: 'boolean', short: 'v', default: false },
    help: { type: 'boolean', short: 'h', default: false },
  },
  allowPositionals: true,
});

if (values.help) {
  console.log('Usage: click-parser [--icon] /path/to/click');
  process.exit(0);
}

if (positionals.length !== 1) {
  console.error('Usage: click-parser /path/to/click');
  process.exit(1);
}
else {
  parse(positionals[0], !!values.icon).then((data) => {
    console.log(JSON.stringify(data, null, 4));
    process.exit(0);
  }).catch((err) => {
    console.error('Failed to parse: ', err);
    process.exit(1);
  });
}
