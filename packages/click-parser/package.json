{
  "name": "click-parser",
  "version": "5.0.0",
  "description": "Extract data from Ubuntu's click packages",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noemit",
    "test": "node -r ts-node/register --test test/*.ts",
    "lint": "eslint src/*.ts test/*.ts bin/click-parser"
  },
  "bin": {
    "click-parser": "bin/click-parser"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/theopenstore/openstore.git"
  },
  "keywords": [
    "click",
    "ubuntu",
    "debian",
    "package",
    "deb",
    "scope",
    "clickable",
    "ubports",
    "ubuntu-touch"
  ],
  "author": "Brian Douglass",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://gitlab.com/theopenstore/openstore/-/issues"
  },
  "homepage": "https://gitlab.com/theopenstore/openstore",
  "dependencies": {
    "fast-xml-parser": "^4.5.0",
    "modern-tar": "^0.7.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "eslint": "^8.57.1",
    "eslint-config-bhdouglass": "^0.0.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
