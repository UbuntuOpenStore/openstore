{
  "name": "click-parser",
  "version": "5.1.0",
  "description": "Extract data from Ubuntu's click packages",
  "keywords": [
    "click",
    "clickable",
    "deb",
    "debian",
    "package",
    "scope",
    "ubports",
    "ubuntu",
    "ubuntu-touch"
  ],
  "homepage": "https://gitlab.com/theopenstore/openstore",
  "bugs": {
    "url": "https://gitlab.com/theopenstore/openstore/-/issues"
  },
  "license": "AGPL-3.0-or-later",
  "author": "Brian Douglass",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/theopenstore/openstore.git"
  },
  "bin": {
    "click-parser": "bin/click-parser"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noemit",
    "test": "node -r tsx/cjs --test --experimental-test-module-mocks test/*.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint src/*.ts test/*.ts bin/click-parser",
    "lint:nofix": "oxlint src/*.ts test/*.ts bin/click-parser"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "oxlint": "^1.66.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
