---
// SPDX-License-Identifier: AGPL-3.0-or-later
import { CategoriesSchema } from "@/lib/schema";
import { cn, getRelativeLocaleUrl, localeSlugToCode } from "@/lib/utils";

export type Props = {
  class?: string;
  showDivider?: boolean;
  linkClass?: string;
  selected?: string;
};

const response = await fetch(`${import.meta.env.PUBLIC_API_URL}api/v4/categories?all=true&lang=${localeSlugToCode(Astro.currentLocale)}`, {
  headers: { "X-Source": "openstore-web-next" },
});
const { data } = await response.json();
const categories = CategoriesSchema.parse(data);

const { showDivider = true, linkClass = "text-ubuntu-orange font-bold", selected } = Astro.props;
---

<div class={cn("space-y-2", Astro.props.class)}>
  {
    categories.map((category) => (
      <div>
        <a
          href={getRelativeLocaleUrl(Astro.currentLocale, `/apps/${category.slug}/`)}
          class={cn("text-lg flex gap-2 mb-2", linkClass, selected === category.slug && "font-bold")}
        >
          <img src={category.icon} alt="" class="h-6 w-6" />

          {category.translation}
        </a>

        <div class={cn("w-full h-0.5", showDivider && "bg-ubuntu-gradient rounded-full")} />
      </div>
    ))
  }
</div>
