---
// SPDX-License-Identifier: AGPL-3.0-or-later
import { t } from "i18next";
import { categories } from "@/lib/categories";
import { cn, getRelativeLocaleUrl } from "@/lib/utils";

export type Props = {
  class?: string;
  showDivider?: boolean;
  linkClass?: string;
  selected?: string;
};

const { showDivider = true, linkClass = "text-ubuntu-orange font-bold", selected } = Astro.props;
---

<div class={cn("space-y-2", Astro.props.class)}>
  {
    categories.map((category) => (
      <div>
        <a
          href={getRelativeLocaleUrl(Astro.currentLocale, `/apps/${category.slug}/`)}
          class={cn("text-lg flex gap-2 mb-2", linkClass, selected === category.slug && "font-bold")}
        >
          <img src={category.icon} alt="" class="h-6 w-6" />

          {t(category.name)}
        </a>

        <div class={cn("w-full h-0.5", showDivider && "bg-ubuntu-gradient rounded-full")} />
      </div>
    ))
  }
</div>
