---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { t } from "i18next";
import { generateSchema } from "@/lib/json-schema";
import { type SlimAppData, type UserData } from "@/lib/schema";
import { AppSearchSchema } from "@/lib/schema";
import AppList from "@/components/apps/AppList.tsx";
import { getUserById } from "@/lib/user";
import SvgGlobe from "@/components/icons/Globe";
import SvgGithub from "@/components/icons/Github";
import SvgGitlab from "@/components/icons/Gitlab";
import SvgUser from "@/components/icons/User";
import SvgHeart from "@/components/icons/Heart";
import { initializeI18N } from "@/lib/i18n";

export const prerender = false;

const { id } = Astro.params;
const locale = Astro.currentLocale;
await initializeI18N(locale);

let userData: UserData | undefined;
let userApps: SlimAppData[] = [];

if (id) {
  userData = await getUserById(id);
}

if (!userData) {
  return new Response(null, {
    status: 404,
    statusText: "Not found",
  });
}

const appUrl = new URL("api/v4/apps", import.meta.env.PUBLIC_API_URL);
appUrl.searchParams.set("publisher", userData.name || userData.username);
appUrl.searchParams.set("limit", "32");
appUrl.searchParams.set("sort", "-published_date");
const appsResponse = await fetch(appUrl, {
  headers: { "X-Source": "openstore-web-next" },
});

let hasMoreApps = false;
if (appsResponse.ok) {
  const { data: appsData } = await appsResponse.json();
  const parsedData = AppSearchSchema.parse(appsData);
  userApps = parsedData.packages;
  hasMoreApps = parsedData.count > userApps.length;
}

const url = new URL(Astro.request.url);
const schema = generateSchema(url.toString(), [{ name: userData?.name || userData?.username || id!, path: url.pathname }]);
---

<BaseLayout
  pageTitle={userData.name || userData.username}
  title={userData.name || userData.username}
  description={t("User profile on the OpenStore")}
  schema={schema}
>
  <div class="container mx-auto px-4">
    {
      userData && (
        <>
          <section class="section">
            <div class="flex flex-col md:flex-row gap-6 items-center md:items-start">
              <div class="shrink-0">
                {userData.avatar ? (
                  <img
                    src={userData.avatar}
                    alt={userData.name || userData.username}
                    class="w-24 h-24 md:w-32 md:h-32 rounded-full"
                    width="128"
                    height="128"
                  />
                ) : (
                  <div class="w-24 h-24 md:w-32 md:h-32 rounded-full bg-gray-200 flex items-center justify-center">
                    <span class="text-3xl font-bold text-gray-500">
                      {(userData.name || userData.username || "?").charAt(0).toUpperCase()}
                    </span>
                  </div>
                )}
              </div>

              <div class="flex-1">
                <h1 class="text-3xl md:text-4xl font-bold text-center md:text-left">{userData.name || userData.username}</h1>

                {userData.description && <p class="mt-2 text-gray-700 max-w-3xl text-center md:text-left">{userData.description}</p>}

                <div class="flex flex-wrap gap-3 mt-4 justify-center md:justify-start">
                  {userData.website_url && (
                    <a
                      href={userData.website_url}
                      target="_blank"
                      rel="noopener noreferrer nofollow"
                      class="inline-flex items-center gap-1 text-sm px-3 py-1 bg-gray-100 hover:bg-gray-200 rounded-full transition"
                      title={t("Website")}
                    >
                      <SvgGlobe />
                      <span>{t("Website")}</span>
                    </a>
                  )}

                  {userData.github_profile_url && (
                    <a
                      href={userData.github_profile_url}
                      target="_blank"
                      rel="noopener noreferrer nofollow"
                      class="inline-flex items-center gap-1 text-sm px-3 py-1 bg-gray-100 hover:bg-gray-200 rounded-full transition"
                      title={t("GitHub")}
                    >
                      <SvgGithub />
                      <span>{t("GitHub")}</span>
                    </a>
                  )}

                  {userData.gitlab_profile_url && (
                    <a
                      href={userData.gitlab_profile_url}
                      target="_blank"
                      rel="noopener noreferrer nofollow"
                      class="inline-flex items-center gap-1 text-sm px-3 py-1 bg-gray-100 hover:bg-gray-200 rounded-full transition"
                      title={t("GitLab")}
                    >
                      <SvgGitlab />
                      <span>{t("GitLab")}</span>
                    </a>
                  )}

                  {userData.ubports_forum_username && (
                    <a
                      href={`https://forums.ubports.com/user/${userData.ubports_forum_username}`}
                      target="_blank"
                      rel="noopener noreferrer nofollow"
                      class="inline-flex items-center gap-1 text-sm px-3 py-1 bg-gray-100 hover:bg-gray-200 rounded-full transition"
                      title={t("UBports Forum")}
                    >
                      <SvgUser />
                      <span>{t("UBports Forum")}</span>
                    </a>
                  )}

                  {userData.donation_url && (
                    <a
                      href={userData.donation_url}
                      target="_blank"
                      rel="noopener noreferrer nofollow"
                      class="inline-flex items-center gap-1 text-sm px-3 py-1 bg-gray-100 hover:bg-gray-200 rounded-full transition"
                      title={t("Support")}
                    >
                      <SvgHeart />
                      <span>{t("Support")}</span>
                    </a>
                  )}
                </div>
              </div>
            </div>
          </section>

          {userApps.length > 0 && (
            <>
              <div class="mx-auto w-full max-w-6xl h-1 bg-ubuntu-gradient rounded-full" />

              <section class="section">
                <h2 class="text-2xl font-bold mb-6 text-center">{t("Apps")}</h2>

                <AppList
                  apps={userApps}
                  currentLocale={locale}
                  messages={{
                    new: t("new"),
                    app: t("app"),
                    bookmark: t("bookmark"),
                    webapp: t("webapp"),
                  }}
                />
              </section>

              {hasMoreApps && (
                <section class="section text-center">
                  <a
                    href={`/apps/#search=publisher:${userData.name || userData.username}`}
                    class="inline-block px-4 py-2 bg-primary text-white rounded hover:bg-primary-dark transition"
                  >
                    {t("View all apps by this user")}
                  </a>
                </section>
              )}
            </>
          )}
        </>
      )
    }
  </div>
</BaseLayout>
