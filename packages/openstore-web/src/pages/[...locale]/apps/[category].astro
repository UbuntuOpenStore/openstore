---
// SPDX-License-Identifier: AGPL-3.0-or-later
import BaseLayout from "@/layouts/BaseLayout.astro";
import SearchApps from "@/components/SearchApps";
import CategoryList from "@/components/CategoryList.astro";
import { categories, type Category } from "@/lib/categories";
import { initializeI18N } from "@/lib/i18n";
import { t } from "i18next";
import { generateSchema } from "@/lib/json-schema";
import { getRelativeLocaleUrlList } from "astro:i18n";
import { config } from "@/lib/config";

export type Props = {
  category: Category;
};

export function getStaticPaths() {
  const paths = getRelativeLocaleUrlList();

  return categories.flatMap((category) => {
    return paths.map((path) => ({
      params: {
        category: category.slug,
        locale: path.split("/")[1],
      },
      props: {
        category,
      },
    }));
  });
}

await initializeI18N(Astro.currentLocale);

const { category } = Astro.props;
const categoryName = t(category.name);
---

<BaseLayout
  title="OpenStore"
  pageTitle={categoryName + " | OpenStore"}
  description={t("The open source app store for Ubuntu Touch")}
  schema={generateSchema(Astro.url.href, [
    { name: "Apps", path: "/apps/" },
    { name: category.name, path: `/apps/${category.slug}/` },
  ])}
>
  <section class="grow flex flex-row py-3 px-4">
    <CategoryList class="mx-12 w-96 mb-2 hidden md:block" showDivider={false} linkClass="" selected={category.slug} />

    <div class="w-full">
      <SearchApps
        clickSupportEnabled={config.clickSupportEnabled}
        category={category.name}
        categoryName={categoryName}
        messages={{
          all: t("All Types"),
          apps: t("Apps"),
          bookmarks: t("Bookmarks"),
          webapps: t("Web Apps"),
          filter: t("Filters"),
          showNsfwFilter: t("Show NSFW Apps"),
          new: t("New!"),
          app: t("App"),
          bookmark: t("Bookmark"),
          webapp: t("Web App"),
          notFound: t("No apps found"),
          previous: t("Go back a page"),
          next: t("Go to the next page"),
          error: t("There was an error loading the app list. Please try again later."),
          search: t("Search"),
          sortBy: t("Sort by:"),
          sortOptions: t("Sort Options"),
          options: {
            relevance: t("Relevance"),
            "-calculated_rating": t("Most Popular"),
            calculated_rating: t("Least Popular"),
            name: t("Title (A-Z)"),
            "-name": t("Title (Z-A)"),
            "-published_date": t("Newest"),
            published_date: t("Oldest"),
            "-updated_date": t("Latest Update"),
            updated_date: t("Oldest Update"),
          },
        }}
        currentLocale={Astro.currentLocale}
        client:only="preact"
      />

      <noscript>
        <p class="text-xl">{t("This feature requires JavaScript")}</p>
      </noscript>
    </div>
  </section>
</BaseLayout>
