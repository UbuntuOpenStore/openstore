---
import RevisionPage from "@/components/manage/RevisionPage";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getRelativeLocaleUrl } from "@/lib/utils";

export const prerender = false;

const { id } = Astro.params;
if (!id) {
  return Astro.redirect(getRelativeLocaleUrl(Astro.currentLocale, "/manage/"));
}

const apikey = Astro.cookies.get("apikey")?.value;
if (!apikey) {
  return Astro.redirect(getRelativeLocaleUrl(Astro.currentLocale, "/login/"));
}
---

<BaseLayout
  title="OpenStore"
  pageTitle="Manage App Revision | OpenStore"
  description="The open source app store for Ubuntu Touch"
  schema={undefined}
>
  <RevisionPage id={id} currentLocale={Astro.currentLocale} client:only="preact" />
</BaseLayout>
