---
// SPDX-License-Identifier: AGPL-3.0-or-later
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdminMenu from "../../components/admin/AdminMenu";
import CreatePackageForm from "../../components/admin/CreatePackageForm";
import { config } from "../../lib/config";
import { getUser } from "../../lib/user";
import Loading from "../../components/Loading";

export const prerender = false;

const apikey = Astro.cookies.get("apikey")?.value;
if (!apikey) {
  return Astro.redirect("/login/");
}

const user = await getUser(apikey);
if (!user) {
  Astro.cookies.delete("apikey");
  return Astro.redirect("/login/");
}

if (!user.role || user.role !== "admin") {
  return Astro.redirect("/");
}
---

<BaseLayout
  title="Create Package | OpenStore"
  pageTitle="Create Package"
  description="Create a new package in OpenStore"
  schema={undefined}
>
  <section class="section">
    <h1 class="text-4xl">Create Package</h1>

    <AdminMenu currentPath={Astro.url.pathname} />

    <div class="w-full h-[1px] bg-ubuntu-gradient rounded-full mx-auto max-w-6xl"></div>
  </section>

  <section class="section grow max-w-2xl">
    <CreatePackageForm client:only="preact" clickSupportEnabled={config.clickSupportEnabled}>
      <Loading slot="fallback" />
    </CreatePackageForm>
  </section>
</BaseLayout>
