---
// SPDX-License-Identifier: AGPL-3.0-or-later
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdminMenu from "../../components/admin/AdminMenu";
import { getUser } from "../../lib/user";

export const prerender = false;

const apikey = Astro.cookies.get("apikey")?.value;
if (!apikey) {
  return Astro.redirect("/login/");
}

const user = await getUser(apikey);
if (!user) {
  Astro.cookies.delete("apikey");
  return Astro.redirect("/login/");
}

// Check if user is admin
if (!user.role || user.role !== "admin") {
  return Astro.redirect("/");
}
---

<BaseLayout
  title="Admin Dashboard | OpenStore"
  pageTitle="Admin Dashboard"
  description="Manage OpenStore administration tasks"
  schema={undefined}
>
  <section class="section h-full">
    <h1 class="text-4xl">Admin Dashboard</h1>

    <AdminMenu currentPath={Astro.url.pathname} />
  </section>
</BaseLayout>
