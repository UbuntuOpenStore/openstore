---
import Loading from "@/components/Loading";
import ProfileForm from "@/components/manage/ProfileForm";
import ApiKeyDisplay from "@/components/manage/ApiKeyDisplay";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getUser, invalidateUserCache } from "@/lib/user";
import { initializeI18N } from "@/lib/i18n";
import { t } from "i18next";
import SvgExternalLink from "@/components/icons/ExternalLink";

export const prerender = false;

const apikey = Astro.cookies.get("apikey")?.value;
if (!apikey) {
  return Astro.redirect("/login/");
}

const user = await getUser(apikey, false);
if (!user) {
  Astro.cookies.delete("apikey");
  return Astro.redirect("/login/");
}

// Invalidate the user cache in case the user will update their profile, the actual update occurs on the client instead of the server
// so we need to make sure we don't serve stale data from the cache on the next request
await invalidateUserCache(apikey);

await initializeI18N(Astro.currentLocale);
---

<BaseLayout
  title={`${t("Profile")} | OpenStore`}
  pageTitle={t("Profile")}
  description={t("Manage your OpenStore profile information")}
  schema={undefined}
>
  <section class="section">
    <h1 class="text-4xl">{t("Profile")}</h1>
    <p class="py-4">
      <a href={`/users/${user._id}/`} target="_blank" class="underline">{t("View public profile")}</a>
      <a href={`/users/${user._id}/`} target="_blank">
        <SvgExternalLink class="inline w-4 h-4" />
      </a>
    </p>
  </section>

  <ProfileForm
    user={user}
    messages={{
      errorOccurred: t("An error occurred while saving your profile"),
      username: t("Username"),
      usernameCannotBeChanged: t("Username cannot be changed"),
      email: t("Email"),
      emailManagedByProvider: t("Email is managed by your login provider"),
      avatar: t("Avatar"),
      uploadNewAvatar: t("Upload new avatar"),
      profilePicture: t("Profile picture"),
      imageFileTypes: t("JPG or PNG, max 2MB"),
      biography: t("Biography"),
      shortBio: t("Short bio"),
      maximumChars: t("Maximum 200 characters"),
      contactLinks: t("Contact Links"),
      websiteURL: t("Website URL"),
      githubProfileURL: t("GitHub Profile URL"),
      gitlabProfileURL: t("GitLab Profile URL"),
      ubportsForumUsername: t("UBports Forum Username"),
      donationURL: t("Donation URL"),
      saving: t("Saving..."),
      save: t("Save"),
    }}
    client:only="preact"
  >
    <Loading slot="fallback" />
  </ProfileForm>

  <div class="my-6">
    <ApiKeyDisplay
      apiKey={apikey}
      messages={{
        apiKey: t("API Key"),
        yourApiKey: t("Your API Key"),
        showApiKey: t("Show API Key"),
        hideApiKey: t("Hide API Key"),
        copyToClipboard: t("Copy to clipboard"),
        copied: t("Copied!"),
        keepSecure: t("Keep your API key secure and do not share it with others"),
        allowsAccess: t("This key allows access to your account"),
      }}
      client:only="preact"
    />
  </div>
</BaseLayout>
